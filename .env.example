# ===== OpenSky Network API credentials =====
# OpenSky uses the OAuth2 "client credentials" flow (no username/password since March 2026).
# Create an API client at https://opensky-network.org (My OpenSky -> Account -> API Client).

OPENSKY_CLIENT_ID=your_client_id_here
OPENSKY_CLIENT_SECRET=your_client_secret_here

# Host and port are set in package.json ("next dev/start -H 127.0.0.1 -p 3000").
# Keep it on localhost unless you add authentication: the API is open and spends your credits.

# Feed pacing
# Poll interval for a small (<= 25 sq deg, 1 credit) area. Larger areas poll 1.5x / 2x / 3x slower.
FEED_BASE_INTERVAL_MS=10000
# Floor for any poll interval (OpenSky's authenticated time resolution is 5 s)
MIN_POLL_INTERVAL_MS=5000
# Daily /states credits for your account tier (standard 4000, active feeder 8000).
# Polling slows down 2x below 25% remaining and 4x below 10%.
OPENSKY_DAILY_CREDITS=4000
