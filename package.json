{
  "name": "aerotrack",
  "version": "1.0.0",
  "private": true,
  "description": "AeroTrack — Real-time global flight tracker with interactive 3D map. Built with Next.js 16, deck.gl, and MapLibre GL by Vishal Raghav.",
  "author": "Vishal Raghav <vishalraghav0290@gmail.com> (https://github.com/vishalraghav0290)",
  "license": "MIT",
  "homepage": "https://aerotrack.live",
  "repository": {
    "type": "git",
    "url": "https://github.com/vishalraghav0290/FlyingAero.git"
  },
  "bugs": {
    "url": "https://github.com/vishalraghav0290/FlyingAero/issues"
  },
  "keywords": [
    "flight-tracker",
    "real-time",
    "adsb",
    "aviation",
    "deck-gl",
    "maplibre",
    "nextjs",
    "typescript",
    "vishal-raghav"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup-maplibre": "mkdir -p public/lib/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/lib/maplibre/ && cp node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/lib/maplibre/",
    "postinstall": "npm run setup-maplibre"
  },
  "dependencies": {
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/maplibre": "^9.4.0",
    "@deck.gl/react": "^9.4.0",
    "deck.gl": "^9.4.0",
    "dotenv": "^17.4.2",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.5",
    "postcss": "^8.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
